set -ex

if [ "$1" = replace ]; then
    sh packages/bleux-features/feature replace_features ' preremove' packages/bleux-features/features/preremove.csv 4 remove disable customize
	sh packages/bleux-features/feature replace_features ' add' packages/bleux-features/features/add.csv 4 add enable customize
	sh packages/bleux-features/feature replace_features ' remove' packages/bleux-features/features/remove.csv 4 remove disable customize
    exit
fi

# Install bleUX repository
if [ ! -d /usr/local/bleux/ ]; then
     wget https://github.com/natanjunges/bleux/releases/latest/download/bleux-repository.deb
     sudo apt-get install -y ./bleux-repository.deb
     rm bleux-repository.deb
fi

# Update bleUX repository
sudo apt-get update --no-list-cleanup -o Dir::Etc::SourceList="sources.list.d/bleux.sources" -o Dir::Etc::SourceParts="-"

# Install bleUX packages
sudo apt-get install -y bleux-desktop

# Purge transitional packages
sudo apt-get purge -y firefox thunderbird

####begin preremove
sh '/usr/lib/bleux-features/features/snap.sh' 'remove'
####end preremove

####begin add
sudo apt-get install -y --mark-auto bleux-backgrounds
sudo apt-get install -y --mark-auto gnome-console
sh '/usr/lib/bleux-features/features/gnome-software.sh' 'add'
sudo apt-get install -y --mark-auto gnome-system-monitor
sudo apt-get install -y --mark-auto gnome-tour
sudo apt-get install -y --mark-auto preload
sudo apt-get install -y --mark-auto software-properties-gtk
sh '/usr/lib/bleux-features/features/ufw.sh' 'enable'
sh '/usr/lib/bleux-features/features/flatpak.sh' 'add'
flatpak install -y --noninteractive --no-related org.gnome.baobab
flatpak install -y --noninteractive --no-related org.mozilla.firefox
flatpak install -y --noninteractive --no-related org.gnome.Calculator
flatpak install -y --noninteractive --no-related org.gnome.Characters
flatpak install -y --noninteractive --no-related org.gnome.clocks
flatpak install -y --noninteractive --no-related org.gnome.font-viewer
flatpak install -y --noninteractive --no-related org.gnome.Logs
flatpak install -y --noninteractive --no-related org.gnome.TextEditor
flatpak install -y --noninteractive --no-related org.gnome.Loupe
flatpak install -y --noninteractive --no-related org.gnome.Papers
####end add

# Install extended packages in extended install
if dpkg-query -f '${db:Status-abbrev}' -W usb-creator-gtk 2> /dev/null | grep -q '^.i'; then
    unminimize customize
fi

####begin remove
sudo dpkg-divert --add --rename --divert /usr/share/gnome-shell/extensions/ding@rastersoft.com/metadata.json.disabled /usr/share/gnome-shell/extensions/ding@rastersoft.com/metadata.json
sudo dpkg-divert --add --rename --divert /usr/share/gnome-shell/extensions/ubuntu-dock@ubuntu.com/metadata.json.disabled /usr/share/gnome-shell/extensions/ubuntu-dock@ubuntu.com/metadata.json
sudo apt-get purge -y baobab
sudo apt-get purge -y deja-dup
sudo apt-get purge -y file-roller
sudo apt-get purge -y gnome-calculator
sudo apt-get purge -y gnome-calendar
sudo apt-get purge -y gnome-characters
sudo apt-get purge -y gnome-clocks
sudo apt-get purge -y gnome-font-viewer
sudo apt-get purge -y gnome-initial-setup
sudo apt-get purge -y gnome-logs
sudo apt-get purge -y gnome-snapshot
sudo apt-get purge -y gnome-text-editor
sudo apt-get purge -y libreoffice-calc libreoffice-gnome libreoffice-impress libreoffice-math libreoffice-style-colibre libreoffice-style-yaru libreoffice-uiconfig-common libreoffice-writer
sudo apt-get purge -y loupe
sudo apt-get purge -y papers
sudo apt-get purge -y ptyxis
sudo apt-get purge -y remmina
sudo apt-get purge -y resources
sudo apt-get purge -y rhythmbox
sudo apt-get purge -y seahorse
sudo apt-get purge -y shotwell
sudo apt-get purge -y showtime
sudo apt-get purge -y simple-scan
sudo apt-get purge -y transmission-gtk
sudo apt-get purge -y ubuntu-wallpapers
####end remove

# Finish installation of language support
sudo apt-get install -y $(check-language-support)

# Purge unused packages
sudo apt-get autoremove -y --purge

# Finish installation of flatpak runtimes
feature update flatpak

# Reset icon theme
dconf reset /org/gnome/desktop/interface/icon-theme

# Reset app picker layout
dconf reset /org/gnome/shell/app-picker-layout

# Reset welcome dialog last shown version
dconf reset /org/gnome/shell/welcome-dialog-last-shown-version
