set -e -x

# Install bleUX repository
if [ ! -d /usr/local/bleux/ ]; then
     wget https://github.com/natanjunges/bleux/releases/latest/download/bleux-repository.deb
     sudo apt-get install -y ./bleux-repository.deb
     rm bleux-repository.deb
fi

# Update bleUX repository
sudo apt-get update --no-list-cleanup -o Dir::Etc::SourceList="sources.list.d/bleux.sources" -o Dir::Etc::SourceParts="-"

# Install bleUX packages
sudo apt-get install -y bleux-desktop

# Purge transitional packages
sudo apt-get purge -y firefox thunderbird

# Remove snap before adding gnome-software
feature remove snap

# Add features
feature add gnome-backgrounds
feature add gnome-console
feature add gnome-software
feature add gnome-system-monitor
feature add gnome-tour
feature add preload
feature add software-properties
feature enable ufw
feature add flatpak
feature add flatpak baobab
feature add flatpak firefox
feature add flatpak gnome-calculator
feature add flatpak gnome-characters
feature add flatpak gnome-clocks
feature add flatpak gnome-font-viewer
feature add flatpak gnome-logs
feature add flatpak gnome-text-editor
feature add flatpak loupe
feature add flatpak papers

# Install extended packages in extended install
if dpkg-query -f '${db:Status-abbrev}' -W usb-creator-gtk 2> /dev/null | grep -q '^.i'; then
    unminimize customize
fi

# Disable/remove features
feature remove baobab
feature remove deja-dup
feature disable desktop-icons
feature remove file-roller
feature remove gnome-calculator
feature remove gnome-calendar
feature remove gnome-characters
feature remove gnome-clocks
feature remove gnome-font-viewer
feature remove gnome-initial-setup
feature remove gnome-logs
feature remove gnome-snapshot
feature remove gnome-text-editor
feature remove libreoffice
feature remove loupe
feature remove papers
feature remove ptyxis
feature remove remmina
feature remove resources
feature remove rhythmbox
feature remove seahorse
feature remove shotwell
feature remove showtime
feature remove simple-scan
feature remove transmission
feature disable ubuntu-dock
feature remove ubuntu-wallpapers

# Finish installation of language support
sudo apt-get install -y $(check-language-support)

# Purge unused packages
sudo apt-get autoremove -y --purge

# Finish installation of flatpak runtimes
feature update flatpak

# Reset icon theme
dconf reset /org/gnome/desktop/interface/icon-theme

# Reset app picker layout
dconf reset /org/gnome/shell/app-picker-layout

# Reset welcome dialog last shown version
dconf reset /org/gnome/shell/welcome-dialog-last-shown-version
