include ../build-common

control: ../bleux-ux/programs/preremove.csv ../bleux-ux/programs/remove.csv
	sed -Ei "s/^#   /    /; s/^    ($$( \
		cat $^ | while read program; do \
			program_type="$$(echo "$$program" | cut -d , -f 2)"; \
			program_resources="$$(echo "$$program" | cut -d , -f 3)"; \
			case "$$program_type" in \
				custom) \
					if [ "$$program_resources" ]; then \
						printf "$$program_resources|" | tr ' ' '|'; \
					fi; \
				;; \
				deb) \
					if [ -z "$$program_resources" ]; then \
						program_resources="$$(echo "$$program" | cut -d , -f 1)"; \
					fi; \
					printf "$$program_resources|" | tr ' ' '|'; \
				;; \
			esac; \
		done; \
	)),/#   \1,/" '$@'

minimize: ../bleux-ux/programs/extended.csv
	sh ../bleux-ux/ux replace_programs '' '$^' 5 remove disable '$@'

unminimize: ../bleux-ux/programs/extended.csv
	sh ../bleux-ux/ux replace_programs '' '$^' 4 add enable '$@'
