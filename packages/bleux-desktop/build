include ../build-common

control: ../bleux-features/features/preremove.csv ../bleux-features/features/remove.csv
	sed -Ei "s/^#   /    /; s/^    ($$( \
		cat $^ | while read feature; do \
			feature_type="$$(echo "$$feature" | cut -d , -f 2)"; \
			feature_resources="$$(echo "$$feature" | cut -d , -f 3)"; \
			case "$$feature_type" in \
				custom) \
					if [ "$$feature_resources" ]; then \
						printf "$$feature_resources|" | tr ' ' '|'; \
					fi; \
				;; \
				deb) \
					if [ -z "$$feature_resources" ]; then \
						feature_resources="$$(echo "$$feature" | cut -d , -f 1)"; \
					fi; \
					printf "$$feature_resources|" | tr ' ' '|'; \
				;; \
			esac; \
		done; \
	)),/#   \1,/" '$@'

minimize: ../bleux-features/features/extended.csv
	sh ../bleux-features/feature replace_features '' '$^' 5 remove disable '$@'

unminimize: ../bleux-features/features/extended.csv
	sh ../bleux-features/feature replace_features '' '$^' 4 add enable '$@'
