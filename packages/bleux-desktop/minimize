set -ex

if ! dpkg-query -f '${db:Status-abbrev}' -W bleux-features 2> /dev/null | grep -q '^.i'; then
    echo 'The \e[1mbleux-features\e[0m package is not installed.' >&2
    exit 1
fi

sudo apt-get purge -y $(dpkg-query -f '${Suggests}' -W bleux-desktop | tr -d ,)
####begin
sudo apt-get purge -y gufw
sudo apt-get purge -y timeshift
flatpak remove -y --noninteractive --delete-data org.gnome.DejaDup
flatpak remove -y --noninteractive --delete-data org.gnome.Calendar
flatpak remove -y --noninteractive --delete-data org.gnome.Connections
flatpak remove -y --noninteractive --delete-data org.gnome.Music
flatpak remove -y --noninteractive --delete-data org.gnome.Snapshot
flatpak remove -y --noninteractive --delete-data org.libreoffice.LibreOffice
flatpak remove -y --noninteractive --delete-data org.gnome.Showtime
flatpak remove -y --noninteractive --delete-data org.gnome.SimpleScan
flatpak remove -y --noninteractive --delete-data org.mozilla.thunderbird
flatpak remove -y --noninteractive --delete-data com.transmissionbt.Transmission
####end
sudo apt-get autoremove -y --purge
feature remove-unused flatpak
dconf reset /org/gnome/shell/app-picker-layout
