set -ex

if ! dpkg-query -f '${db:Status-abbrev}' -W bleux-ux 2> /dev/null | grep -q '^.i'; then
    echo 'The \e[1mbleux-ux\e[0m package is not installed.' >&2
    exit 1
fi

if [ "$1" != customize ]; then
    sudo apt-get install -y --mark-auto $(dpkg-query -f '${Suggests}' -W bleux-desktop | tr -d ,)
fi

####begin
sudo apt-get install -y --mark-auto gufw timeshift
flatpak install -y --noninteractive --no-related org.gnome.DejaDup org.gnome.Calendar org.gnome.Connections org.gnome.Music org.gnome.Snapshot org.libreoffice.LibreOffice org.gnome.Showtime org.gnome.SimpleScan org.mozilla.thunderbird com.transmissionbt.Transmission
####end

if [ "$1" != customize ]; then
    ux feature update flatpak
    dconf reset /org/gnome/shell/app-picker-layout
fi
