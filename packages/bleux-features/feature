set -e

generate() {
    case "$1" in
        deb)
            shift

            if [ "$1" = --check ]; then
                shift
            fi

            case "$1" in
                add)
                    shift
                    echo "sudo apt-get install -y --mark-auto $*"
                ;;
                remove)
                    shift
                    echo "sudo apt-get purge -y $*"
                ;;
                *)
                    echo 'echo Unknown subcommand. >&2'
                    echo exit 1
                ;;
            esac
        ;;
        extension)
            if [ "$2" = --check ]; then
                shift
            fi

            case "$2" in
                disable)
                    echo "sudo dpkg-divert --add --rename --divert /usr/share/gnome-shell/extensions/$3/metadata.json.disabled /usr/share/gnome-shell/extensions/$3/metadata.json"
                ;;
                enable)
                    echo "sudo dpkg-divert --remove --rename --divert /usr/share/gnome-shell/extensions/$3/metadata.json.disabled /usr/share/gnome-shell/extensions/$3/metadata.json"
                ;;
                *)
                    echo 'echo Unknown subcommand. >&2'
                    echo exit 1
                ;;
            esac
        ;;
        flatpak)
            check=''

            if [ "$2" = --check ]; then
                shift
                check=1
            fi

            case "$2" in
                add)
                    if [ "$check" ]; then
                        echo 'if ! dpkg-query -f '\''${db:Status-abbrev}'\'' -W flatpak 2> /dev/null | grep -q '\''^.i'\''; then'
                        echo '    echo '\''The\\e[1mflatpak\\e[0mfeature is not enabled.'\'' >&2'
                        echo '    exit 1'
                        echo fi
                    fi

                    echo "flatpak install -y --noninteractive --no-related $3"
                ;;
                remove)
                    if [ "$check" ]; then
                        echo 'if dpkg-query -f '\''${db:Status-abbrev}'\'' -W flatpak 2> /dev/null | grep -q '\''^.i'\''; then'
                        printf '    '
                    fi

                    echo "flatpak remove -y --noninteractive --delete-data $3"

                    if [ "$check" ]; then
                        echo fi
                    fi
                ;;
                *)
                    echo 'echo Unknown subcommand. >&2'
                    echo exit 1
                ;;
            esac
        ;;
        snap)
            check=''

            if [ "$2" = --check ]; then
                shift
                check=1
            fi

            case "$2" in
                add)
                    if [ "$check" ]; then
                        echo 'if ! dpkg-query -f '\''${db:Status-abbrev}'\'' -W snapd 2> /dev/null | grep -q '\''^.i'\''; then'
                        echo '    echo '\''The\\e[1msnap\\e[0mfeature is not enabled.'\'' >&2'
                        echo '    exit 1'
                        echo fi
                    fi

                    echo "sudo snap install $3"
                ;;
                remove)
                    if [ "$check" ]; then
                        echo 'if dpkg-query -f '\''${db:Status-abbrev}'\'' -W snapd 2> /dev/null | grep -q '\''^.i'\''; then'
                        printf '    '
                    fi

                    echo "sudo snap remove --purge $3"

                    if [ "$check" ]; then
                        echo fi
                    fi
                ;;
                *)
                    echo 'echo Unknown subcommand. >&2'
                    echo exit 1
                ;;
            esac
        ;;
        *)
            echo 'echo Unknown feature type. >&2'
            echo exit 1
        ;;
    esac
}

replace() {
    sed -i "/^####begin$1\$/,/^####end$1\$/c\\####begin$1\\n$(
        cat $2 | while read feature; do
            feature_type="$(echo "$feature" | cut -d , -f 2)"

            case "$feature_type" in
                custom)
                    eval "$3"
                ;;
                feature_type)
                ;;
                $4)
                    eval "$5"
                    feature_resources="$(echo "$feature" | cut -d , -f 3)"

                    if [ -z "$feature_resources" ]; then
                        feature_resources="$(echo "$feature" | cut -d , -f 1)"
                    fi

                    eval "$6"
                ;;
            esac
        done | $7
    )n####end$1" $8
}

replace_features() {
    replace "$1" "$2" 'echo "sh '\''/usr/lib/bleux-features/features/$(echo "$feature" | cut -d , -f 1 | tr '\'' '\'' /).sh'\'' '\''$(echo "$feature" | cut -d , -f '$3')'\''\\"' '*' 'case "$feature_type" in
        deb|flatpak|snap)
            subcommand='$4'
        ;;
        extension)
            subcommand='$5'
        ;;
        *)
            subcommand="$feature_type"
        ;;
    esac' 'generate "$feature_type" "$subcommand" $feature_resources | sed -E '\''s/^(.*)$/\1\\/'\' cat "$6"
}

replace_packages() {
    replace "$1" "$2" 'for package in $(echo "$feature" | cut -d , -f 3); do
        echo "    $package,\\"
    done' deb true 'for package in $feature_resources; do
        echo "    $package,\\"
    done' 'sort -u' "$3"
}

case "$1" in
    generate)
        shift
        generate "$@"
    ;;
    replace_features)
        shift
        replace_features "$@"
    ;;
    replace_packages)
        shift
        replace_packages "$@"
    ;;
    *)
        subcommand="$1"
        shift

        case "$*" in
            feature_name)
                feature=''
            ;;
            *)
                feature="$(cat /usr/lib/bleux-features/features/preremove.csv /usr/lib/bleux-features/features/add.csv /usr/lib/bleux-features/features/extended.csv /usr/lib/bleux-features/features/remove.csv /usr/lib/bleux-features/features/extras.csv | grep -m 1 "^$*,")"
            ;;
        esac

        if [ -z "$feature" ]; then
            echo 'Unknown feature.' >&2
            exit 1
        fi

        feature_type="$(echo "$feature" | cut -d , -f 2)"

        case "$feature_type" in
            custom)
                feature="/usr/lib/bleux-features/features/$(echo "$*" | tr ' ' /).sh"

                if [ ! -e "$feature" ]; then
                    echo 'Unknown feature.' >&2
                    exit 1
                fi

                sh "$feature" "$subcommand"
            ;;
            *)
                feature_resources="$(echo "$feature" | cut -d , -f 3)"

                if [ -z "$feature_resources" ]; then
                    feature_resources="$*"
                fi

                eval "$(generate "$feature_type" --check "$subcommand" $feature_resources)"
            ;;
        esac
    ;;
esac
